		{"name": "oc", "aliases": ["ochat"], "args": "<message>"},
		{"name": "ac", "args": "<message>", "unconfirmed": true},
		{"name": "cc", "aliases": ["cchat", "coopchat"], "args": "<message>"},
		{"name": "visit", "aliases": ["guest"], "names": "players", "args": "<player>"},
		{"name": "invite", "names": "players", "args": "<player>"},
		{"name": "trade", "names": "players", "args": "<player>", "unconfirmed": true},
		{"name": "pv", "aliases": ["viewprofile"], "names": "players", "args": "<player>", "unconfirmed": true},
