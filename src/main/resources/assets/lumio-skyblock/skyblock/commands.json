{
	"about": "The commands of the chat suggestions. Entries with \"unconfirmed\": true have no source yet; what the game shows in chat is added to a local list on top of this file.",
	"sources": [
		"/friend, /party and /guild: the help pages of the game, from the player's screenshots; the descriptions are in our own short words",
		"https://hypixelskyblock.minecraft.wiki/w/Commands",
		"https://support.hypixel.net/hc/en-us/articles/360019551320 (party: help, invite, list)",
		"https://support.hypixel.net/hc/en-us/articles/360019646459 (guild: join, info, invite, accept, menu, help, quest, settings)",
		"https://www.minecraftiplist.com/blog/master-hypixel-party-chat-commands-tips-for-seamless-communication/ (party: leave, settings, warp)"
	],
	"commands": [
		{"name": "party", "aliases": ["p"], "names": "players", "args": "<player>", "subs": [
			{"name": "accept", "args": "<player>", "names": "players", "desc": "Join a party you were invited to"},
			{"name": "chat", "desc": "Switch your chat to the party"},
			{"name": "demote", "args": "<player>", "names": "players", "desc": "Lower a member's party rank"},
			{"name": "disband", "desc": "End the party"},
			{"name": "invite", "args": "<players...>", "names": "players", "desc": "Invite players to the party"},
			{"name": "kick", "args": "<player>", "names": "players", "desc": "Remove a member from the party"},
			{"name": "kickoffline", "desc": "Remove the offline members"},
			{"name": "leave", "desc": "Leave the party"},
			{"name": "list", "desc": "Show who is in the party"},
			{"name": "mute", "desc": "Turn party chat on or off"},
			{"name": "poll", "args": "<question/answer/answer/answer...>", "desc": "Ask the party a question"},
			{"name": "private", "desc": "Make party games private"},
			{"name": "promote", "args": "<player>", "names": "players", "desc": "Raise a member's party rank"},
			{"name": "settings", "args": "<setting> <value>", "desc": "Change a party setting"},
			{"name": "transfer", "args": "<player>", "names": "players", "desc": "Give the party to another member"},
			{"name": "warp", "desc": "Warp the party to your server"}
		]},
		{"name": "guild", "aliases": ["g"], "subs": [
			{"name": "accept", "desc": "Accept a guild invite"},
			{"name": "chat", "args": "<chat message>", "desc": "Write in guild chat"},
			{"name": "create", "args": "<name>", "desc": "Found a guild"},
			{"name": "demote", "args": "<player>", "names": "players", "desc": "Lower a member's guild rank"},
			{"name": "disband", "desc": "End your guild"},
			{"name": "discord", "desc": "Show or set the guild's Discord"},
			{"name": "help", "desc": "Show the guild commands"},
			{"name": "history", "desc": "Show the guild's history"},
			{"name": "info", "desc": "Show facts about your guild"},
			{"name": "invite", "args": "<player>", "names": "players", "desc": "Invite a player to the guild"},
			{"name": "join", "args": "<guild>", "desc": "Ask to join a guild"},
			{"name": "kick", "args": "<player> <reason>", "names": "players", "desc": "Remove a member from the guild"},
			{"name": "leave", "desc": "Leave your guild"},
			{"name": "log", "desc": "Show the guild's audit log"},
			{"name": "member", "desc": "Show facts about a member"},
			{"name": "members", "desc": "List the guild's members"},
			{"name": "menu", "desc": "Open the guild menu"},
			{"name": "motd", "desc": "See or edit the message of the day"},
			{"name": "mute", "args": "<player/everyone> <time>", "names": "players", "values": ["everyone"], "desc": "Silence a member or everyone"},
			{"name": "mypermissions", "desc": "Show what your rank may do"},
			{"name": "notifications", "desc": "Turn guild join and leave lines on or off"},
			{"name": "officerchat", "desc": "Write in officer chat"},
			{"name": "online", "desc": "List members who are online"},
			{"name": "promote", "args": "<player>", "names": "players", "desc": "Raise a member's guild rank"},
			{"name": "quest", "desc": "Show the guild quest"},
			{"name": "rename", "args": "<name>", "desc": "Rename the guild"},
			{"name": "setrank", "args": "<player> <rank>", "names": "players", "desc": "Give a member a rank"},
			{"name": "settings", "args": "<setting> <value>", "desc": "Change a guild setting"},
			{"name": "slow", "desc": "Turn guild chat's slow mode on or off"},
			{"name": "tag", "desc": "Set the guild's tag"},
			{"name": "tagcolor", "desc": "Set the color of the guild's tag"},
			{"name": "toggle", "desc": "Show guild chat or hide it"},
			{"name": "top", "desc": "Show the members' best guild Exp"},
			{"name": "transfer", "args": "<player>", "names": "players", "desc": "Give the guild to another member"}
		]},
		{"name": "friend", "aliases": ["f", "friends"], "names": "players", "args": "<player>", "subs": [
			{"name": "accept", "args": "<player>", "names": "players", "desc": "Accept a friend request"},
			{"name": "add", "args": "<player>", "names": "players", "desc": "Send a friend request"},
			{"name": "best", "args": "<player>", "names": "players", "desc": "Mark or unmark a best friend"},
			{"name": "deny", "args": "<player>", "names": "players", "desc": "Decline a friend request"},
			{"name": "help", "desc": "Show the friend commands"},
			{"name": "list", "args": "<page/best>", "values": ["best"], "desc": "List your friends"},
			{"name": "nickname", "args": "<player> <nickname>", "names": "players", "desc": "Give a friend a nickname"},
			{"name": "notifications", "desc": "Turn join and leave lines on or off"},
			{"name": "remove", "args": "<player>", "names": "players", "desc": "Remove a friend"},
			{"name": "removeall", "desc": "Remove all friends except best friends"},
			{"name": "requests", "args": "<page>", "desc": "Show your friend requests"}
		]},
		{"name": "ignore", "subs": [
			{"name": "add", "args": "<player>", "names": "players", "unconfirmed": true},
			{"name": "remove", "args": "<player>", "unconfirmed": true},
			{"name": "list", "unconfirmed": true},
			{"name": "help", "unconfirmed": true}
		]},
		{"name": "chat", "values": ["all", "a", "party", "p", "guild", "g", "officer", "o", "skyblock-coop", "coop"], "args": "<channel>"},
		{"name": "message", "aliases": ["msg", "w", "whisper", "tell"], "names": "players", "args": "<player> <message>"},
		{"name": "reply", "aliases": ["r"], "args": "<message>"},
		{"name": "pc", "aliases": ["pchat"], "args": "<message>"},
